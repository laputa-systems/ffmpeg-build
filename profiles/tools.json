{
  "contract": 1,
  "profile": "tools",
  "license": "gpl",
  "artifact": "tools",
  "description": "Headless ffmpeg and ffprobe pair for local postprocessing. GPL. No playback SDK, network, or ffplay; the only device is the virtual lavfi input.",
