      "sine",
      "testsrc2",
      "cropdetect"
    ],
    "hwaccels": [],
    "protocols": [
      "file",
      "pipe",
      "fd"
    ]
  },
  "targets": {
    "aarch64-apple-darwin": {
      "platform": "macos",
      "arch": "aarch64",
      "deployment_target": "27.0",
      "cpu_baseline": "arm64",
      "configure_flags": [
        "--enable-videotoolbox",
        "--enable-audiotoolbox"
      ],
      "components": {
        "encoders": [
          "hevc_videotoolbox",
          "aac_at"
        ],
        "hwaccels": [
          "h264_videotoolbox",
          "hevc_videotoolbox"
        ]
      },
      "frameworks": [
        "VideoToolbox",
        "AudioToolbox",
        "CoreFoundation",
        "CoreMedia",
        "CoreVideo",
        "CoreServices"
      ],
      "external_libraries": [
        "dav1d"
      ],
      "bundled_dependencies": [
        "dav1d",
        "zlib"
      ],
      "system_libraries": []
    },
    "x86_64-unknown-linux-musl": {
      "platform": "linux",
      "arch": "x86_64",
      "cpu_baseline": "x86-64",
      "configure_flags": [
        "--enable-vaapi"
      ],
      "components": {
