{
  "contract": 1,
  "profile": "runtime",
  "artifact": "runtime",
  "description": "Shared FFmpeg runtime: ffmpeg, ffprobe, and the libav* shared libraries, headers, and pkg-config files they run on. The union of tools and play-sdk. No devices, network protocols, or ffplay.",
  "sources": [
    "ffmpeg",
    "dav1d",
    "zlib"
  ],
  "components": {
    "demuxers": [
      "mov",
      "matroska",
      "mpegts",
      "mp3",
      "ogg",
      "avi",
      "asf",
      "flv",
      "mpegps",
      "mpegvideo",
      "rm",
      "image2",
      "webvtt",
      "srt",
      "ffmetadata",
      "lavfi",
      "flac",
      "wav"
    ],
    "decoders": [
